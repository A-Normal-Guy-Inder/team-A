# The API and socket URLs default to the host the page was served from, on port
# 5000 (see src/config/index.js). Leaving them unset for local development is
# deliberate: a hardcoded 127.0.0.1 here while the app is opened on localhost
# makes the browser drop the SameSite=Lax session cookie, and every request then
# fails with "Not authorized, no token". Set them explicitly when building
# against a deployed backend.
#
# In production these are set in the Vercel dashboard, not here — real environment
# variables take precedence over this file, and CRA inlines them at build time, so
# changing them needs a redeploy rather than a restart.
#
# REACT_APP_API_URL=https://api.example.com/api
# REACT_APP_SOCKET_URL=https://api.example.com
# REACT_APP_API_PORT=5000

# Request timeout in ms. Defaults to 90s to survive a free-tier cold start; drop it
# to ~30000 once the backend is on an always-on plan.
# REACT_APP_API_TIMEOUT=90000

REACT_APP_PAGE_SIZE=12
